{
  "name": "rivals-clipper",
  "productName": "Rivals Clipper",
  "version": "0.2.0",
  "description": "Auto-clips Marvel Rivals kills and streaks, stores and ranks highlights, and (soon) turns them into reels.",
  "author": {
    "name": "Ferris"
  },
  "license": "MIT",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "npm run build && electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node -e \"require('fs').rmSync('dist-test',{recursive:true,force:true})\" && tsc -p tsconfig.test.json && node --test dist-test/test/*.test.js",
    "dist": "npm run build && electron-builder --publish=never",
    "harness": "npm run build && node dist/tools/harness.js",
    "build:native": "powershell -ExecutionPolicy Bypass -File scripts/build-native.ps1",
    "predist": "pwsh -NoProfile -File scripts/prepare-window-capture.ps1"
  },
  "build": {
    "appId": "com.ferris.rivalsclipper",
    "productName": "Rivals Clipper",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "!dist/tools/**",
      "renderer/**/*",
      "package.json",
      "!node_modules/@tesseract.js-data/eng/4.0.0/**",
      "!node_modules/ffmpeg-static/ffmpeg.exe"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "RivalsClipper-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Rivals Clipper"
    },
    "asarUnpack": [
      "node_modules/**",
      "node_modules/tesseract.js-core/**"
    ],
    "extraResources": [
      {
        "from": "native/bin",
        "to": "native",
        "filter": [
          "rc-audio.exe",
          "ffmpeg.exe",
          "ffmpeg-LICENSE.txt"
        ]
      }
    ]
  },
  "dependencies": {
    "@tesseract.js-data/eng": "1.0.0",
    "ffmpeg-static": "5.3.0",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "@overwolf/ow-electron": "44.9.0",
    "@overwolf/ow-electron-packages-types": "1.1.14",
    "@types/node": "22.15.0",
    "electron": "45.2.2",
    "electron-builder": "26.18.0",
    "typescript": "5.8.3"
  },
  "overrides": {
    "glob@>=9.0.0 <=14.0.1": "14.0.2",
    "minimatch@>=7.0.0 <11.0.1": "11.0.1"
  }
}
