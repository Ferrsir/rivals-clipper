{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "types": ["node", "@overwolf/ow-electron", "@overwolf/ow-electron-packages-types"]
  },
  "include": ["src/**/*.ts"]
}
